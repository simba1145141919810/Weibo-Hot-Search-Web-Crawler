# ========================================
# 1. 你的项目私密与本地数据文件（⚠️ 绝对禁止上传）
# ========================================
# Streamlit 密钥文件
.streamlit/
.streamlit/secrets.toml

# 本地 SQLite 数据库
weibo_hot_data.db
*.db

# 本地生成的快照和日志文件夹
history_snapshots/
*.xlsx

# ========================================
# 2. Python 及开发环境通用忽略文件
# ========================================
# Python 缓存
__pycache__/
*.py[cod]
*$py.class

# 虚拟环境
venv/
env/
.env

# PyCharm 配置文件
.idea/